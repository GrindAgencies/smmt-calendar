{
  "appId": "app.tsfg.standard",
  "appName": "The Standard",
  "webDir": "www",
  "server": {
    "url": "https://tsfg.app/app.html",
    "cleartext": false,
    "iosScheme": "https"
  },
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#0b0f1a",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1100,
      "backgroundColor": "#0b0f1a",
      "showSpinner": false
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
